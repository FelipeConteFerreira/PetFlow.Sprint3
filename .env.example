# Copie para .env e ajuste. Só o host: o prefixo /api é acrescentado pelo app.

# Backend publicado (padrão embutido no app — é contra ele que a demo roda)
EXPO_PUBLIC_API_URL=https://clyvo-vet-api-java.onrender.com

# ---------------------------------------------------------------------------
# Rodando contra um backend local
#
# NÃO use http://localhost:8080. Emulador e aparelho físico têm o próprio
# localhost, que não é o da sua máquina — a chamada falha com "Sem conexão".
#
#   Emulador Android .......... EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#   Simulador iOS ............. EXPO_PUBLIC_API_URL=http://localhost:8080
#   Aparelho físico ........... EXPO_PUBLIC_API_URL=http://<IP-DA-SUA-MAQUINA>:8080
#                               (mesmo Wi-Fi; descubra com ipconfig / ifconfig)
#   Túnel (redes que isolam) .. npx expo start --tunnel e use a URL pública
#
# Lembre de liberar a porta 8080 no firewall do Windows para o aparelho físico.
# ---------------------------------------------------------------------------

# Tempo máximo de espera por resposta, em ms.
# O padrão de 90000 existe porque a instância gratuita do Render dorme e a
# primeira chamada acorda a máquina. Contra backend local ou já quente, baixe:
# EXPO_PUBLIC_API_TIMEOUT_MS=15000
